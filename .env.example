# El formulario permanece desactivado si cualquiera de estos dos flags no es true.
NEXT_PUBLIC_CONTACT_FORM_ENABLED=false
CONTACT_FORM_ENABLED=false

# Activar únicamente después de validar la información jurídica y la página /privacidad.
NEXT_PUBLIC_PRIVACY_NOTICE_READY=false
PRIVACY_NOTICE_READY=false

# Orígenes autorizados para la ruta del formulario.
ALLOWED_CONTACT_ORIGINS=https://espaiemocions.es,https://www.espaiemocions.es

# Entrega transaccional. No guardar valores reales en Git.
RESEND_API_KEY=re_xxxxxxxxx
CONTACT_FROM_EMAIL="Espai Emocions <web@espaiemocions.es>"
CONTACT_TO_EMAIL=contacte@espaiemocions.es

# Datos jurídicos que debe confirmar el responsable antes de activar el formulario.
PRIVACY_CONTROLLER_NAME=
PRIVACY_CONTROLLER_ID=
PRIVACY_POSTAL_ADDRESS=
PRIVACY_CONTACT_EMAIL=
PRIVACY_PROCESSORS=
PRIVACY_TRANSFERS=
